# User-Agent sent with every request to Wikimedia APIs (Wikidata Query Service).
#
# It must follow the Wikimedia Foundation User-Agent Policy:
# https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
#
#     <client name>/<version> (<contact information>) <library>/<version>
#
# The contact information (a URL, e-mail address or wiki user page) is NOT optional.
# Requests with a generic or contact-less User-Agent are aggressively throttled by the
# Wikidata Query Service, which fails with:
#     HTTP Error 429: Aggressively rate-limiting to 1 req / min
#
# Copy this file to '.env' in the repository root and replace the contact details
# below with your own. Do not run the tool with someone else's contact information.

GLAMOROUS_USER_AGENT="GLAMorousToHTML-bot/1.0 (https://github.com/YOUR-ORG/YOUR-REPO; you@example.org) SPARQLWrapper/Python"
